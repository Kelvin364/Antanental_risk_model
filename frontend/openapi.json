  "paths": {
    "/api/artefact": {
      "get": {
        "description": "The artefact's version record (version.json).",
        "operationId": "artefact_api_artefact_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Artefact Api Artefact Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Artefact",
        "tags": [
          "health"
        ]
      }
    },
    "/api/caseload": {
      "get": {
        "description": "Assessed synthetic cases ordered by predicted probability.",
        "operationId": "caseload_api_caseload_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseloadOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Caseload",
        "tags": [
          "cases"
        ]
      }
    },
    "/api/cases": {
      "post": {
        "description": "Register a synthetic pregnancy. Refused unless the synthetic flag is set.",
        "operationId": "create_case_api_cases_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Case",
        "tags": [
          "cases"
        ]
      }
    },
    "/api/cases/{case_id}": {
      "get": {
